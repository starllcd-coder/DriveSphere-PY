DJANGO_ENV=development
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_ENGINE=django.db.backends.sqlite3
DB_NAME=web/db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Postgres (docker-compose defaults)
POSTGRES_DB=drivesphere
POSTGRES_USER=drivesphere
POSTGRES_PASSWORD=drivesphere

# Redis / cache / background jobs
USE_REDIS_CACHE=0
REDIS_URL=redis://127.0.0.1:6379/1
DEFAULT_CACHE_TTL=300
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_SYNC_NOTIFICATIONS_MINUTES=60
CELERY_DAILY_REPORTS_HOURS=24
CELERY_BACKUP_HOURS=24
CELERY_ANOMALY_HOURS=6
CELERY_INTEGRATIONS_HOURS=6

# Backup retention
BACKUP_RETENTION_DAYS=14

# Optional monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# API hardening
API_PAGE_SIZE=25
API_THROTTLE_ANON=60/minute
API_THROTTLE_USER=300/minute
API_THROTTLE_AUTH_LOGIN=10/minute
API_THROTTLE_OTP_VERIFY=20/minute

# Web login brute-force limits
LOGIN_ATTEMPT_LIMIT=8
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_BLOCK_SECONDS=900

# CORS
CORS_ALLOW_ALL_ORIGINS=0
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Credential encryption
DATA_ENCRYPTION_KEY=change-me-too

# OTP
OTP_DEBUG_RETURN_CODE=1
OTP_TTL_SECONDS=90
OTP_RATE_LIMIT_MAX=3
OTP_RATE_LIMIT_WINDOW_SECONDS=600
OTP_BLOCK_VOIP=1

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
DEFAULT_FROM_EMAIL=noreply@drivesphere.local

# Central Platform connector integration
CENTRAL_PLATFORM_URL=http://127.0.0.1:8000
CENTRAL_CONNECTOR_SECRET=dev-connector-secret
CENTRAL_CONNECTOR_SIGNED=0
CENTRAL_TENANT_CODE=
CENTRAL_MODULE_CODE=drivesphere
